# Background worker: WhatsApp message batching, media download, AI processing, analytics.
# Consumes the BullMQ queues in Redis. Deploy anywhere that runs a long-lived container
# (Railway, Render, Fly.io, a VPS). Configure it with the same env vars as the web app.
FROM node:22-slim

WORKDIR /app
ENV NODE_ENV=production

COPY package.json package-lock.json ./
# tsx (a devDependency) runs the TypeScript worker, so dev dependencies are needed.
RUN npm ci --include=dev && npm cache clean --force

COPY . .

# Run node directly (not via npm) so SIGTERM reaches the worker for a graceful shutdown.
CMD ["node", "--import", "tsx", "workers/index.ts"]
