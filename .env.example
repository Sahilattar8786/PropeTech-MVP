# ─── Core ────────────────────────────────────────────────────────────────
# MongoDB connection string
DATABASE_URL=mongodb://127.0.0.1:27017/propflow
# Public base URL of the app (marketing + dashboard). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: serve broker sites on subdomains, e.g. propflow.in → rehanbrokers.propflow.in
# (for local testing use "localhost:3000" and open http://<slug>.localhost:3000)
NEXT_PUBLIC_ROOT_DOMAIN=

# ─── Auth (Auth.js) ──────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Optional Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated emails with access to /admin
ADMIN_EMAILS=

# ─── AI ──────────────────────────────────────────────────────────────────
# OpenAI (or any OpenAI-compatible API). Without a key the deterministic
# rules provider is used (extraction works offline; copy is template-based).
AI_API_KEY=
AI_PROVIDER=
AI_MODEL=gpt-4.1-mini
AI_API_URL=https://api.openai.com/v1

# ─── WhatsApp Business Cloud API (Meta) ──────────────────────────────────
# Without an access token + phone number id the sandbox provider is used.
WHATSAPP_PROVIDER=
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Token you enter in the Meta dashboard when subscribing the webhook
WHATSAPP_VERIFY_TOKEN=
# App secret used to verify X-Hub-Signature-256 (required in production)
WHATSAPP_APP_SECRET=
# The business number brokers message, with country code
WHATSAPP_BUSINESS_NUMBER=
# How long to wait for the rest of a message burst (text + photos) before processing
WHATSAPP_BATCH_WINDOW_MS=15000

# ─── Queue (BullMQ) ──────────────────────────────────────────────────────
# When set, jobs go to Redis and must be consumed by `npm run worker`.
# When empty, jobs run in-process (development only).
REDIS_URL=

# ─── Object storage ──────────────────────────────────────────────────────
# local (development) or s3 (AWS S3 / Cloudflare R2 / MinIO)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL for stored objects (bucket domain or CDN)
S3_PUBLIC_URL=
# Secret for signed private media URLs (defaults to NEXTAUTH_SECRET)
MEDIA_SIGNING_SECRET=

# ─── Custom domains ──────────────────────────────────────────────────────
# CNAME target brokers point their domain at (Vercel's, unless you use another host)
CUSTOM_DOMAIN_CNAME_TARGET=cname.vercel-dns.com

# ─── Billing ─────────────────────────────────────────────────────────────
# mock (plans activate instantly) or razorpay
BILLING_PROVIDER=mock
